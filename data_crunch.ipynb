    "fig = go.Figure()\n",
    "\n",
    "for year in ERAA_target_years:\n",
    "    df = demands[year]\n",
    "\n",
    "    df_GW = df/1000 #converting MW into GW\n",
    "\n",
    "    # Build a plotting x-axis where the target year is replaced with a common dummy year (e.g., 1900)\n",
    "    idx = df.index\n",
    "\n",
    "    fig.add_trace(\n",
    "        go.Scatter(\n",
    "            x=idx,\n",
    "            y=df_GW[Notebook_climatic_year],\n",
    "            mode=\"lines\",\n",
    "            name=f\"Year {year}\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "fig.update_layout(\n",
    "    title=f\"Hourly Electricity Demand (Superposed Across Years)\",\n",
    "    xaxis_title=\"Date (Year removed)\",\n",
    "    yaxis_title=\"Demand (GW)\",\n",
    "    hovermode=\"x unified\",\n",
    "    template=\"plotly_white\",\n",
    "    legend_title=\"Year\",\n",
    "    width=1100,\n",
    "    height=600\n",
    ")\n",
    "\n",
    "# Set labels\n",
    "fig.update_xaxes(\n",
    "    dtick=None,\n",
    "    tickformat=\"%d %b\\n%H:%M\"\n",
    ")\n",
    "\n",
    "fig.show()"
   ]
