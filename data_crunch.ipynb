    "ldc = {}\n",
    "\n",
    "for year in ERAA_target_years:\n",
    "    df = demands[year].copy()\n",
    "    ldc_df = pd.DataFrame()\n",
    "    \n",
    "    for col in df.columns:\n",
    "        # Sort descending to create load duration curve\n",
    "        ldc_df[col] = df[col].sort_values(ascending=False).reset_index(drop=True)\n",
    "    \n",
    "    ldc[year] = ldc_df"
