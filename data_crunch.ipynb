    "        bat_duration=battery_duration_h,\n",
    "        bat_eff=bat_eff,\n",
    "        cycle_day=cycle_day,\n",
    "    )\n",
    "else:\n",
    "    net_load = net_demand_no_battery.copy()"
   ]
