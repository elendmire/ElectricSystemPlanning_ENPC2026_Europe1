  {
   "cell_type": "markdown",
   "id": "1886c014",
   "metadata": {},
   "source": [
    "### 1.2.2 - Useful indicators for profile analysis\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fda9e5dd",
   "metadata": {},
   "source": [
    "Let's compute basic statistics from demand profile:\n",
    "- Total Annual Demand\n",
    "- Peak Demand\n",
    "- Daily Variation (maximal load spread in a single day)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d4c3725f",
   "metadata": {},
   "source": [
    "Computing the indicators"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "d862a668",
   "metadata": {},
   "outputs": [],
   "source": [
    "results = []\n",
    "\n",
    "for year in ERAA_target_years:\n",
    "    df = demands[year].copy()\n",
    "\n",
    "    # Ensure index is datetime\n",
    "    df.index = pd.to_datetime(df.index)\n",
    "\n",
    "    # 1) Total annual demand (MWh)\n",
    "    # Demand is in MW sampled hourly ⇒ sum gives MWh\n",
    "    total_demand_mwh = df[Notebook_climatic_year].sum()\n",
    "\n",
    "    # 2) Peak demand (MW)\n",
    "    peak_load = df[Notebook_climatic_year].max()\n",
    "\n",
    "    # 3) Seasonal variation:\n",
    "    #   Compute average demand per month\n",
    "    monthly_avg = df[Notebook_climatic_year].resample(\"ME\").mean()\n",
    "    seasonal_variation = monthly_avg.max() - monthly_avg.min()\n",
    "\n",
    "    # 4) Daily variation:\n",
    "    #   Compute daily max-min spread\n",
    "    daily_spread = df[Notebook_climatic_year].resample(\"D\").apply(lambda x: x.max() - x.min())\n",
    "    daily_variation = daily_spread.max()\n",
    "\n",
    "    results.append({\n",
    "        \"Year\": year,\n",
    "        \"Total_Demand_TWh\": total_demand_mwh,\n",
    "        \"Peak_Load_GW\": peak_load,\n",
    "        \"Seasonal_Variation_GW\": seasonal_variation,\n",
    "        \"Max_Daily_Variation_GW\": daily_variation,\n",
    "    })\n",
    "\n",
    "results_df = pd.DataFrame(results).set_index(\"Year\")"
   ]
  },
