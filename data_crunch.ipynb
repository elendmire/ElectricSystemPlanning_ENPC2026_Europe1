   "metadata": {},
   "source": [
    "**Impacts on indicators defined in the Demand Section**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "eeaa254d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---- Compute indicators for 2025 and 2033 ----\n",
    "\n",
    "# ============================================================\n",
    "# Step 1: load solar capacity factors for EACH year (2025, 2033, ...)\n",
    "# ============================================================\n",
    "res_capacity_folder = \"data/ERAA_2023-2/res_capa-factors\"\n",
    "\n",
    "solar_cf_by_year = {}\n",
    "for year in ERAA_target_years:\n",
    "    solar_file = f\"{res_capacity_folder}/capa_factor_solar_pv_{year}_{country_choice}.csv\"\n",
    "    df_solar = pd.read_csv(solar_file, sep=\";\")\n",
    "    df_solar[\"date\"] = pd.to_datetime(df_solar[\"date\"])\n",
    "    df_solar[\"value\"] = pd.to_numeric(df_solar[\"value\"], errors=\"coerce\")\n",
    "\n",
    "    cf = df_solar.pivot_table(index=\"date\", columns=\"climatic_year\", values=\"value\").sort_index()\n",
    "    cf.columns = [f\"CY{cy}\" for cy in cf.columns]\n",
    "    solar_cf_by_year[year] = cf\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Step 2: compute indicators on NET demand, for each year / capacity / climatic year\n",
    "# ============================================================\n",
    "results_net = []\n",
    "\n",
    "for year in ERAA_target_years:\n",
    "    climatic_years_available = [\n",
    "        cy for cy in net_demand_hydroRoR[year].keys() if cy in solar_cf_by_year[year].columns\n",
    "    ]\n",
    "\n",
    "    for capa in solar_pv_capacities:\n",
    "        for cy in climatic_years_available:\n",
    "            base = net_demand_hydroRoR[year][cy]  # MW, indexed on real `year` dates\n",
    "            solar_gen = capa * solar_cf_by_year[year][cy].values  # MW\n",
    "\n",
    "            net_hydro_solarPV = pd.Series(\n",
    "                base.values - solar_gen,\n",
    "                index=pd.to_datetime(base.index)\n",
    "            )\n",
    "\n",
    "            # 1) Total annual net demand (TWh) — MWh sum / 1e6\n",
    "            total_demand_twh = net_hydro_solarPV.sum() / 1e6\n",
    "\n",
    "            # 2) Peak net demand (GW) — MW / 1e3\n",
    "            peak_load = net_hydro_solarPV.max() / 1e3\n",
    "\n",
    "            # 3) Daily variation (GW): max daily (max-min) spread\n",
    "            daily_spread = net_hydro_solarPV.resample(\"D\").apply(lambda x: x.max() - x.min())\n",
    "            daily_variation = daily_spread.max() / 1e3\n",
    "\n",
    "            results_net.append({\n",
    "                \"Year\": year,\n",
    "                \"Climatic_year\": cy,\n",
    "                \"Solar_capacity_MW\": capa,\n",
    "                \"Total_Demand_TWh\": total_demand_twh,\n",
    "                \"Peak_Load_GW\": peak_load,\n",
    "                \"Max_Daily_Variation_GW\": daily_variation,\n",
    "            })\n",
    "\n",
    "results_net_df = pd.DataFrame(results_net)\n",
    "\n",
    "# ============================================================\n",
    "# Step 3: Select the indicators for Notebook climatic year\n",
    "# ============================================================\n",
    "indicators = [\n",
    "    \"Total_Demand_TWh\",\n",
    "    \"Peak_Load_GW\",\n",
    "    \"Max_Daily_Variation_GW\",\n",
    "]\n",
    "\n",
    "results_notebook_cy_df = results_net_df.loc[results_net_df[\"Climatic_year\"] == Notebook_climatic_year].drop(columns = \"Climatic_year\")\n",
    "\n",
    "results_notebook_cy_df = results_notebook_cy_df.set_index([\"Year\", \"Solar_capacity_MW\"])\n",
    "\n",
    "# ============================================================\n",
    "# Step 4: plot — one figure per indicator\n",
    "# ============================================================\n",
    "year_colors = {\n",
    "    2025: \"31, 119, 180\",   # RGB triplet as string, for rgba()\n",
    "    2033: \"255, 127, 14\",\n",
    "}\n",
    "\n",
    "for indicator in results_notebook_cy_df.columns:\n",
    "    fig = go.Figure()\n",
    "\n",
    "    for year, group in results_notebook_cy_df[indicator].groupby(level = \"Year\"):\n",
    "        fig.add_trace(go.Scatter(\n",
    "            x=group.index.get_level_values('Solar_capacity_MW')/1000, # MW -> GW\n",
    "            y=group.values,\n",
    "            mode='lines+markers',\n",
    "            name=str(year)\n",
    "        ))\n",
    "        \n",
    "    fig.update_layout(\n",
    "        title=f\"{indicator} vs Solar PV Capacity for the two target year\",\n",
    "        xaxis_title=\"Installed Solar Capacity (GW)\",\n",
    "        yaxis_title=indicator.replace(\"_\", \" \"),\n",
    "        legend_title=\"Year\",\n",
    "        width=1000,\n",
    "        height=500,  \n",
    "    )\n",
    "\n",
    "    # Afficher la figure\n",
    "    fig.show()\n"
   ]
