    "        f\"Wind Offshore {capa_wind_offshore/1e3:.0f} GW, Battery {capa_battery/1e3:.0f} GW</sub>\"\n",
    "    ),\n",
    "    xaxis_title=\"Hours\",\n",
    "    yaxis_title=\"Demand (GW)\",\n",
    "    template=\"plotly_white\",\n",
    "    hovermode=\"x unified\",\n",
    "    width=1100,\n",
