 "cells": [
  {
   "cell_type": "markdown",
   "id": "e23d9076",
   "metadata": {},
   "source": [
    "# Imports\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "0e8846e8",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from itertools import combinations\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import plotly.colors as pc\n",
    "import plotly.graph_objects as go\n",
    "from plotly.subplots import make_subplots\n",
    "import pulp\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "72aa033c",
   "metadata": {},
   "source": [
    "# Choice of your study case\n",
    "Choose the country (or  meta-country) that was assigned to your group\n",
    "\n",
    "*Choose between (**in lowercase**): benelux, france, germany, iberian-peninsula, italy, poland, scandinavia*"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "de0c0f2f",
   "metadata": {},
   "outputs": [],
   "source": [
    "country_choice = \"benelux\"\n",
    "\n",
    "#List of target years considered for this practical work\n",
    "ERAA_target_years = [2025,2033]\n",
    "\n",
    "#Target year to plot by default\n",
    "plot_year = 2025"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "chap1_title",
   "metadata": {},
   "source": [
    "# Chapter 1: Power demand\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d9185e76",
   "metadata": {},
   "source": [
    "## 1.1 - Reading and preparing demand data\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "db8b2652",
   "metadata": {},
   "outputs": [],
   "source": [
    "demands = {}\n",
    "for year in ERAA_target_years:\n",
    "    df = pd.read_csv(f\"data/ERAA_2023-2/demand/demand_{year}_{country_choice}.csv\", sep=';', header=0)\n",
    "    pivoted = df.pivot(index='date', columns='climatic_year', values='value')\n",
    "    demands[year] = pivoted"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "252858d5",
   "metadata": {},
   "source": [
    "Renaming the climatic years for clarity, and selecting one to work with in this notebook session. (Different climatic years will be considered later during the week)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "8d73d0eb",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "/tmp/ipykernel_14200/1791043732.py:7: Pandas4Warning: The inplace keyword in DataFrame.rename is deprecated and will be removed in a future version (PDEP-8).\n",
      "See https://pandas.pydata.org/docs/dev/whatsnew/v3.1.0.html#deprecation-inplace for more details.\n",
      "  demands[year].rename(columns={cy: f'CY{cy}'}, inplace=True)\n"
     ]
    }
   ],
   "source": [
    "# List of all unique climatic years considered for this practical work\n",
    "for year in ERAA_target_years:\n",
    "    ERAA_climatic_years = list(demands[year].columns)\n",
    "\n",
    "    # Renaming them CY1, CY2, ... for clarity\n",
    "    for cy in (ERAA_climatic_years):\n",
    "        demands[year].rename(columns={cy: f'CY{cy}'}, inplace=True)\n",
    "\n",
    "climatic_year_cy = [f'CY{cy}' for cy in ERAA_climatic_years]\n",
    "\n",
    "Notebook_climatic_year = 'CY1989'"
   ]
  },
