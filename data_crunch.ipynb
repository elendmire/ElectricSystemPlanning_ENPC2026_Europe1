    ")\n",
    "\n",
    "# net_demand[target_year][target_cy] already has hydro RoR subtracted\n",
    "base_net_demand = net_demand_hydroRoR[plot_year][target_cy]\n",
    "\n",
    "net_demand_no_battery = pd.Series(\n",
    "    base_net_demand.values - res_generation,\n",
    "    index=pd.to_datetime(base_net_demand.index)\n",
    ")\n",
    "\n",
    "if capa_battery > 0:\n",
