    "# ---- Plot ----\n",
    "fig = go.Figure()\n",
    "\n",
    "fig.add_trace(\n",
    "    go.Scatter(\n",
    "        x=ldc[plot_year].index,          # Hour rank\n",
    "        y=ldc[plot_year][Notebook_climatic_year]/1e3,      # Sorted load values\n",
    "        mode=\"lines\",\n",
    "        name=str(year)\n",
    "    )\n",
    ")\n",
    "\n",
    "fig.update_layout(\n",
    "    title=f\"Load Duration Curves – {plot_year} - {country_choice.capitalize()}\",\n",
    "    xaxis_title=\"Hours\",\n",
    "    yaxis_title=\"Demand (GW)\",\n",
    "    template=\"plotly_white\",\n",
    "    hovermode=\"x unified\",\n",
    "    width=1100,\n",
    "    height=600\n",
    ")\n",
    "\n",
    "fig.show()"
   ]
